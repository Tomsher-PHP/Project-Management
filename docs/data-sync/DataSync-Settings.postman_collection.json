    {
      "name": "Technologies",
      "description": "Manage core technology stack masters used across PMS projects.",
      "item": [
        {
          "name": "Sync Technology",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "tech-sync-001",
                "disabled": true
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"module\": \"technologies\",\n  \"code\": \"845621\",\n  \"name\": \"Vue.js\",\n  \"sort_order\": 1,\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/data-sync/settings/sync",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "data-sync",
                "settings",
                "sync"
              ]
            },
            "description": "Upsert a Technology master record. If code does not exist, creates record (HTTP 201). If active code exists, updates record (HTTP 200)."
          }
        },
        {
          "name": "List Technologies",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/data-sync/settings?module=technologies&is_active=1&page=1&per_page=50&sort_by=sort_order&sort_direction=asc",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "data-sync",
                "settings"
              ],
              "query": [
                {
                  "key": "module",
                  "value": "technologies"
                },
                {
                  "key": "is_active",
                  "value": "1"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "50"
                },
                {
                  "key": "sort_by",
                  "value": "sort_order"
                },
                {
                  "key": "sort_direction",
                  "value": "asc"
                },
                {
                  "key": "search",
                  "value": "Vue",
                  "disabled": true
                }
              ]
            },
            "description": "Retrieve a paginated list of technology records with optional search, sorting, and active status filters."
          }
        },
        {
          "name": "Get Technology by Code",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/data-sync/settings/{{technology_code}}?module=technologies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "data-sync",
                "settings",
                "{{technology_code}}"
              ],
              "query": [
                {
                  "key": "module",
                  "value": "technologies"
                }
              ]
            },
            "description": "Retrieve a single Technology master record by its unique 6-digit numeric code."
          }
        },
        {
          "name": "Delete Technology by Code",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/data-sync/settings/{{technology_code}}?module=technologies",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "data-sync",
                "settings",
                "{{technology_code}}"
              ],
              "query": [
                {
                  "key": "module",
                  "value": "technologies"
                }
              ]
            },
            "description": "Soft-delete a Technology record by 6-digit code. System records and records in use by projects are protected (HTTP 409)."
          }
        }
      ]
